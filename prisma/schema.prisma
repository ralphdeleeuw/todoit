generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Family ────────────────────────────────────────────────────────────────

model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  User[]
  invites  FamilyInvite[]
  lists    TaskList[]
  labels   Label[]
  tasks    Task[]
}

enum FamilyRole {
  PARENT
  CHILD
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  dailyReminderEnabled Boolean @default(true)
  xp            Int        @default(0)
  weekXp        Int        @default(0)
  streak        Int        @default(0)
  lastActivityDate DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  familyId String?
  family   Family?    @relation(fields: [familyId], references: [id])
  role     FamilyRole @default(CHILD)

  accounts       Account[]
  sessions       Session[]
  assignedTasks  Task[]            @relation("AssignedTo")
  createdTasks   Task[]            @relation("CreatedBy")
  pushSubs       PushSubscription[]
  ownedLists     TaskList[]        @relation("OwnedLists")
  sharedLists    TaskListMember[]  @relation("SharedListMember")

  @@index([familyId])
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// ─── Invite ────────────────────────────────────────────────────────────────

model FamilyInvite {
  id       String     @id @default(cuid())
  familyId String
  family   Family     @relation(fields: [familyId], references: [id])
  token    String     @unique @default(cuid())
  role     FamilyRole @default(CHILD)
  expiresAt DateTime
  usedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([familyId])
}

// ─── Task Organization ─────────────────────────────────────────────────────

enum ListVisibility {
  PRIVATE
  FAMILY
  SHARED
}

model TaskList {
  id         String         @id @default(cuid())
  name       String
  color      String?
  points     Int            @default(10)
  familyId   String
  family     Family         @relation(fields: [familyId], references: [id])
  ownerId    String?
  owner      User?          @relation("OwnedLists", fields: [ownerId], references: [id])
  visibility ListVisibility @default(FAMILY)
  members    TaskListMember[]
  tasks      Task[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([familyId])
  @@index([ownerId])
}

model TaskListMember {
  listId String
  userId String
  list   TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user   User     @relation("SharedListMember", fields: [userId], references: [id], onDelete: Cascade)

  @@id([listId, userId])
  @@index([userId])
}

model Label {
  id       String      @id @default(cuid())
  name     String
  color    String
  familyId String
  family   Family      @relation(fields: [familyId], references: [id])
  tasks    TaskLabel[]
  createdAt DateTime   @default(now())

  @@index([familyId])
}

// ─── Tasks ─────────────────────────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completedAt DateTime?
  reminderAt  DateTime?

  familyId String
  family   Family    @relation(fields: [familyId], references: [id])

  listId String?
  list   TaskList? @relation(fields: [listId], references: [id])

  assigneeId String?
  assignee   User?   @relation("AssignedTo", fields: [assigneeId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  labels TaskLabel[]

  openForClaim       Boolean @default(false)

  isRecurring        Boolean @default(false)
  recurrenceInterval Int?
  parentTaskId       String?
  parentTask         Task?   @relation("RecurrenceChain", fields: [parentTaskId], references: [id])
  childTasks         Task[]  @relation("RecurrenceChain")

  subtaskParentId String?
  subtaskParent   Task?   @relation("SubtaskChain", fields: [subtaskParentId], references: [id])
  subtasks        Task[]  @relation("SubtaskChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@index([familyId, completedAt])
  @@index([assigneeId])
  @@index([listId])
  @@index([dueDate])
  @@index([createdById])
  @@index([parentTaskId])
  @@index([subtaskParentId])
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

// ─── Push ──────────────────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dhKey String
  authKey   String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}
